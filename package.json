{
	"name": "musicore",
	"version": "0.0.2-alpha+001",
	"author": "Marcus Gustafsson <marcus@marcus.ax> (https://marcus.ax)",
	"packageManager": "pnpm@10.28.0",
	"description": "Manipulate music scores, render sheet music, music theory exercises and more.",
	"keywords": [
		"music",
		"score",
		"sheet music",
		"music theory",
		"music exercises",
		"musicstring"
	],
	"homepage": "https://marcus.ax",
	"licence": "MIT",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"build": "pnpm clean && vite build",
		"build:js": "node esbuild.js",
		"clean": "del-cli ./dist",
		"dev": "vite dev",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "pnpm run package",
		"test": "pnpm run test:integration && pnpm run test:unit",
		"check": "svelte-kit sync && svelte-check  --compiler-warnings 'missing-custom-element-compile-options:ignore' --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:integration": "playwright test",
		"test:unit": "vitest",
		"u": "pnpm update --interactive"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"src/lib",
		"!src/lib/**/*.test.*",
		"!src/lib/**/*.spec.*"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"peerDependencies": {
		"svelte": "^5.31.1"
	},
	"devDependencies": {
		"@playwright/test": "^1.58.2",
		"@sveltejs/adapter-auto": "^3.3.1",
		"@sveltejs/kit": "^2.55.0",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.2.2",
		"@types/eslint": "^9.6.1",
		"autoprefixer": "^10.4.27",
		"del-cli": "^7.0.0",
		"esbuild": "^0.25.5",
		"esbuild-style-plugin": "^1.6.3",
		"esbuild-svelte": "^0.8.2",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.0.0",
		"eslint-plugin-svelte": "^3.15.2",
		"globals": "^16.5.0",
		"happy-dom": "^18.0.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"publint": "^0.3.12",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.5",
		"svelte-preprocess": "^6.0.3",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.1",
		"vite": "^7.3.1",
		"vitest": "^4.0.18"
	},
	"dependencies": {
		"abcjs": "^6.5.1",
		"fraction.js": "^4.3.7"
	}
}
